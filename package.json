{
  "name": "memomind-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @memomind/web dev",
    "dev:api": "pnpm --filter @memomind/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @memomind/database db:generate",
    "db:migrate": "pnpm --filter @memomind/database db:migrate",
    "db:migrate:dev": "pnpm --filter @memomind/database db:migrate:dev",
    "db:push": "pnpm --filter @memomind/database db:push",
    "db:studio": "pnpm --filter @memomind/database db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
