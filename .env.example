# ==============================================================================
# MemoMind AI - Environment Configuration Example
# Safe placeholder values only. Copy to .env for local development.
# ==============================================================================

# Database Configuration (Docker Compose, Supabase & Prisma)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=memomind
POSTGRES_PORT=5438
DATABASE_URL="postgresql://postgres:postgres@localhost:5438/memomind?schema=public"

# NestJS API Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=your-32-character-secret-key-goes-here-in-production
JWT_EXPIRES_IN=7d

# AI Embedding Provider Configuration (Milestone 3 - Vector Indexing & Query Embedding)
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=your-openai-or-compatible-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSIONS=1536

# LLM Chat Provider Configuration (Milestone 4 - RAG Answer Generation)
# Supported LLM_PROVIDER values: "ollama" (local) or "openrouter" (cloud)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=

# Example OpenRouter configuration (uncomment to switch to cloud LLM):
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini
# LLM_API_KEY=your-openrouter-api-key-here

# RAG Retrieval Configuration
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.25
RAG_MAX_CONTEXT_CHARS=6000

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
