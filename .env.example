# ==============================================================================
# MemoMind AI - Environment Configuration Example
# Safe placeholder values only. Copy to .env for local development.
# ==============================================================================

# Database Configuration (Docker Compose & Prisma)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=memomind
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/memomind?schema=public"

# NestJS API Configuration
PORT=4000
NODE_ENV=development

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
